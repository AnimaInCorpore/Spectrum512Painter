Source: "quantize.s"
                            	     1: ; 68000 integer greedy palette builder. Each slot is 16 bytes:
                            	     2: ; RGB12 ID, count, R/G/B sums, signed fixed-point Oklab L/a/b.
                            	     3: ; Counts include two black pseudo-pixels in each of slots 0 and 32.
                            	     4: ; Slot 32 is locked, as in the JavaScript converter.
                            	     5: 
                            	     6: ID      equ 0
                            	     7: COUNT   equ 2
                            	     8: SUMR    equ 4
                            	     9: SUMG    equ 6
                            	    10: SUMB    equ 8
                            	    11: LABL    equ 10
                            	    12: LABA    equ 12
                            	    13: LABB    equ 14
                            	    14: 
                            	    15: ; a0 -> sprite RGB12; a1 -> packed mask; a2 -> destination top-left.
                            	    16: composite_sprite:
00:0000038E 7E1F            	    17:         moveq   #31,d7
                            	    18: .row:
00:00000390 2C19            	    19:         move.l  (a1)+,d6
00:00000392 7A1F            	    20:         moveq   #31,d5
                            	    21: .pixel:
00:00000394 3018            	    22:         move.w  (a0)+,d0
00:00000396 DC86            	    23:         add.l   d6,d6
00:00000398 6402            	    24:         bcc.s   .skip
00:0000039A 3480            	    25:         move.w  d0,(a2)
                            	    26: .skip:
00:0000039C 548A            	    27:         addq.l  #2,a2
00:0000039E 51CDFFF4        	    28:         dbf     d5,.pixel
00:000003A2 45EA0240        	    29:         adda.w  #(320-32)*2,a2
00:000003A6 51CFFFE8        	    30:         dbf     d7,.row
00:000003AA 4E75            	    31:         rts
                            	    32: 
                            	    33: ; Copy the 32 background rows to scratch, then composite at arbitrary ball_x.
                            	    34: prepare_source:
00:000003AC 7000            	    35:         moveq   #0,d0
00:000003AE 303900000008    	    36:         move.w  ball_y,d0
00:000003B4 C0FC0280        	    37:         mulu.w  #640,d0
00:000003B8 41F900048940    	    38:         lea     source_rgb,a0
00:000003BE D1C0            	    39:         adda.l  d0,a0
00:000003C0 43F900009E80    	    40:         lea     work_image,a1
00:000003C6 3E3C13FF        	    41:         move.w  #5119,d7
