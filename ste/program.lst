00:000003E2 08000000        	    48:         btst    #0,d0
00:000003E6 6706            	    49:         beq.s   .even
00:000003E8 41F900068540    	    50:         lea     sprite_rgb_odd,a0
                            	    51: .even:
00:000003EE 43F900068D40    	    52:         lea     sprite_mask,a1
00:000003F4 45F900009E80    	    53:         lea     work_image,a2
