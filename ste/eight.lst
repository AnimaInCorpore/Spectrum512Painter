Source: "eight-balls.s"
                            	     1: ; Build the 202-line six-register stream used by the raster. In fidelity mode
                            	     2: ; each line uses the closest source-row palette for the frontmost ball crossing it;
                            	     3: ; legacy mode copies the original shared palette to every line. The sprite
                            	     4: ; indices stay unchanged, so the existing compiled blitters remain intact.
                            	     5: update_fidelity_palettes:
00:000009FE 2C79000039DA    	     6:         move.l  back_palettes,a6
00:00000A04 3E3C00C9        	     7:         move.w  #201,d7
00:00000A08 4A790000001E    	     8:         tst.w   fidelity_enabled
00:00000A0E 670000DA        	     9:         beq     .copy_global_lines
00:00000A12 4BF9000038DE    	    10:         lea     fidelity_line_rows,a5
00:00000A18 70FF            	    11:         moveq   #-1,d0
                            	    12:         rept 51
                            	    13:         move.l  d0,(a5)+
                            	    14:         endr
00:00000A1A 2AC0            	     1R         move.l  d0,(a5)+
                            	     2R         
