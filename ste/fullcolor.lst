                            	    95:         move.b  1(a0),d2
                            	    96:         add.w   ball_x,d2
                            	    97:         move.w  d2,d3
                            	    98:         lsr.w   #4,d3
                            	    99:         lsl.w   #3,d3
                            	   100:         add.w   d3,d0
                            	   101:         move.l  a6,a1
                            	   102:         adda.l  d0,a1
                            	   103:         moveq   #0,d4
                            	   104:         move.b  (a2,d1.w),d4
                            	   105:         lsl.l   #8,d4
                            	   106:         lsl.l   #4,d4
                            	   107:         moveq   #0,d5
                            	   108:         move.w  2(a0),d5
                            	   109:         add.l   d5,d4
                            	   110:         lea     raw_palette_lookup,a3
                            	   111:         moveq   #0,d6
                            	   112:         move.b  (a3,d4.l),d6
                            	   113:         addi.w  #10,d6
                            	   114:         move.w  #$8000,d4
                            	   115:         move.w  d2,d5
                            	   116:         andi.w  #15,d5
                            	   117:         lsr.w   d5,d4
                            	   118:         move.w  d4,d5
                            	   119:         not.w   d5
                            	   120:         btst    #0,d6
                            	   121:         beq.s   .clear0
                            	   122:         or.w    d4,0(a1)
                            	   123:         bra.s   .plane1
                            	   124: .clear0:
                            	   125:         and.w   d5,0(a1)
                            	   126: .plane1:
                            	   127:         btst    #1,d6
                            	   128:         beq.s   .clear1
                            	   129:         or.w    d4,2(a1)
                            	   130:         bra.s   .plane2
                            	   131: .clear1:
                            	   132:         and.w   d5,2(a1)
                            	   133: .plane2:
                            	   134:         btst    #2,d6
                            	   135:         beq.s   .clear2
                            	   136:         or.w    d4,4(a1)
                            	   137:         bra.s   .plane3
                            	   138: .clear2:
                            	   139:         and.w   d5,4(a1)
                            	   140: .plane3:
                            	   141:         btst    #3,d6
                            	   142:         beq.s   .clear3
                            	   143:         or.w    d4,6(a1)
                            	   144:         bra.s   .next_pixel
                            	   145: .clear3:
                            	   146:         and.w   d5,6(a1)
                            	   147: .next_pixel:
                            	   148:         addq.l  #4,a0
                            	   149:         dbf     d7,.pixel
                            	   150:         rts
                            	   151: 
                            	   152:         endc
                            	   153: ; Restore every previous footprint before drawing any ball. This ordering is
                            	   154: ; essential: restoring one ball after drawing another would erase overlaps.
                            	   155:         ifnd FULL_COLOR
                            	   156: render_balls:
                            	   157:         clr.w   ball_index
                            	   158: .restore:
                            	   159:         bsr     load_ball
                            	   160:         move.w  ball_index,d0
                            	   161:         lsl.w   #2,d0
                            	   162:         move.l  back_positions,a0
                            	   163:         adda.w  d0,a0
                            	   164:         move.w  (a0),back_old_x
                            	   165:         move.w  2(a0),back_old_y
                            	   166:         bsr     restore_ball
                            	   167:         addq.w  #1,ball_index
                            	   168:         cmpi.w  #8,ball_index
                            	   169:         bne.s   .restore
                            	   170:         clr.w   ball_index
                            	   171: .draw:
                            	   172:         bsr     load_ball
                            	   173:         ifd COLORED_BALLS
                            	   174:         bsr     draw_colored_ball
                            	   175:         else
                            	   176:         ifd RAW_FIDELITY
                            	   177:         bsr     draw_ball_raw
                            	   178:         else
                            	   179:         bsr     draw_ball
                            	   180:         tst.w   reuse_enabled
                            	   181:         beq.s   .save
                            	   182:         bsr     reuse_background_colors
                            	   183:         endc
                            	   184:         endc
                            	   185: .save:
