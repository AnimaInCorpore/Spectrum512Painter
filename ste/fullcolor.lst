                            	    80: ; Raw-fidelity path: source pixels remain 12-bit colors and are mapped through
                            	    81: ; a 32-row x 4096-color lookup at draw time. It intentionally favors fidelity
                            	    82: ; over speed and is selected only in the EIGHT-RAW build.
                            	    83: draw_ball_raw:
                            	    84:         move.l  back_screen,a6
                            	    85:         lea     raw_sprite_pixels,a0
                            	    86:         lea     fidelity_line_rows,a2
                            	    87:         move.w  #raw_pixel_count-1,d7
