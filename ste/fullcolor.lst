                            	   190:         move.w  ball_x,(a0)
                            	   191:         move.w  ball_y,2(a0)
                            	   192:         addq.w  #1,ball_index
                            	   193:         cmpi.w  #8,ball_index
                            	   194:         bne.s   .draw
                            	   195:         rts
