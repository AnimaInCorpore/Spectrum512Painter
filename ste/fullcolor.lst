Source: "fullcolor-demo.s"
                            	     1: ; All 16 STE registers shared by eight shaded balls and affected background rows.
                            	     2: ; No dithering. SPACE pauses, R scatters, ESC exits.
                            	     3: COLORED_BALLS equ 1
                            	     4: FULL_COLOR equ 1
                            	     5:         include "eight-demo.s"

