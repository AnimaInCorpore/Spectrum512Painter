Source: "eight-balls.s"
                            	     1: ; Build the 202-line six-register stream used by the raster. In fidelity mode
                            	     2: ; each line uses the closest source-row palette for the frontmost ball crossing it;
                            	     3: ; legacy mode copies the original shared palette to every line. The sprite
                            	     4: ; indices stay unchanged, so the existing compiled blitters remain intact.
                            	     5:         ifnd COLORED_BALLS
                            	     6: update_fidelity_palettes:
                            	     7:         move.l  back_palettes,a6
                            	     8:         move.w  #201,d7
                            	     9:         tst.w   fidelity_enabled
                            	    10:         beq     .copy_global_lines
                            	    11:         lea     fidelity_line_rows,a5
                            	    12:         moveq   #-1,d0
                            	    13:         rept 51
                            	    14:         move.l  d0,(a5)+
                            	    15:         endr
                            	    16:         lea     balls,a0
                            	    17:         moveq   #7,d4
                            	    18: .ball:
                            	    19:         move.w  2(a0),d0
                            	    20:         lea     fidelity_line_rows,a1
                            	    21:         adda.w  d0,a1
                            	    22:         moveq   #0,d1
                            	    23:         moveq   #31,d2
                            	    24: .ball_row:
                            	    25:         move.b  d1,(a1)
                            	    26:         addq.l  #1,a1
                            	    27:         addq.w  #1,d1
                            	    28:         dbf     d2,.ball_row
                            	    29:         addq.l  #8,a0
                            	    30:         dbf     d4,.ball
                            	    31:         lea     fidelity_line_rows,a5
                            	    32: .line:
                            	    33:         moveq   #0,d5
                            	    34:         move.b  (a5)+,d5
                            	    35:         cmpi.b  #$ff,d5
                            	    36:         beq.s   .global_palette
                            	    37:         ifd RAW_FIDELITY
                            	    38:         lea     raw_row_palettes,a0
                            	    39:         else
                            	    40:         lea     fidelity_row_palettes,a0
                            	    41:         endc
                            	    42:         mulu.w  #12,d5
                            	    43:         adda.w  d5,a0
                            	    44:         bra.s   .copy_palette
                            	    45: .global_palette:
                            	    46:         lea     sprite_palette_stream,a0
                            	    47: .copy_palette:
                            	    48:         move.l  (a0)+,d0
                            	    49:         move.l  (a0)+,d1
                            	    50:         move.l  (a0)+,d2
                            	    51:         move.l  d0,(a6)+
                            	    52:         move.l  d1,(a6)+
                            	    53:         move.l  d2,(a6)+
                            	    54:         move.l  d0,(a6)+
                            	    55:         move.l  d1,(a6)+
                            	    56:         move.l  d2,(a6)+
                            	    57:         move.l  d0,(a6)+
                            	    58:         move.l  d1,(a6)+
                            	    59:         move.l  d2,(a6)+
                            	    60:         dbf     d7,.line
                            	    61:         rts
                            	    62: .copy_global_lines:
                            	    63:         lea     sprite_palette_stream,a0
                            	    64:         move.l  (a0)+,d0
                            	    65:         move.l  (a0)+,d1
                            	    66:         move.l  (a0)+,d2
                            	    67: .global_line:
                            	    68:         move.l  d0,(a6)+
                            	    69:         move.l  d1,(a6)+
                            	    70:         move.l  d2,(a6)+
                            	    71:         move.l  d0,(a6)+
                            	    72:         move.l  d1,(a6)+
                            	    73:         move.l  d2,(a6)+
                            	    74:         move.l  d0,(a6)+
                            	    75:         move.l  d1,(a6)+
                            	    76:         move.l  d2,(a6)+
                            	    77:         dbf     d7,.global_line
                            	    78:         rts
