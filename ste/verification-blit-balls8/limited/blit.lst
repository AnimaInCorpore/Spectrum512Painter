Source: "blit.s"
                            	     1: ; Spectrum 512 picture (SPACE.TGA) with a 32x32 ball of 6 colors, drawn by the Blitter with the routines of the
                            	     2: ; stefastbobs2 sprite compiler (assets/blit-ball.s). STE, 60 Hz, vasm Motorola syntax, 68000 only.
                            	     3: ; The ball uses registers 10-15, which hold its colors in all three palette entries of its lines.
                            	     4: ; BAND=1: the picture uses all 16 registers; only the 32 lines of the ball show the version of the picture that
                            	     5: ;         uses registers 0-9, and these lines move with the ball.
                            	     6: ; BAND=0: the version with registers 0-9 everywhere, the palettes never change. BALLS balls (up to 12), all with
                            	     7: ;         the same colors.
                            	     8: ; FRAME_VBLS: a new picture every this many VBLs (1: 60 fps, 3: 20 fps).
                            	     9: ; Build and check with node tools/emulate-blit.mjs. SPACE pauses, ESC exits.
                            	    10: 
                            	    11: 	ifnd BAND
                            	    12: BAND equ 1
                            	    13: 	endc
                            	    14: 	ifnd SPEED_X
                            	    15: SPEED_X equ 2
                            	    16: 	endc
                            	    17: 	ifnd SPEED_Y
                            	    18: SPEED_Y equ 1
                            	    19: 	endc
                            	    20: 	ifnd BALLS
                            	    21: BALLS equ 1
                            	    22: 	endc
                            	    23: 	ifnd FRAME_VBLS
                            	    24: FRAME_VBLS equ 1
                            	    25: 	endc
                            	    26: 	ifne BAND
                            	    27: 	ifne BALLS-1
                            	    28: 	fail "the band variant has one ball"
                            	    29: 	endc
                            	    30: 	endc
                            	    31: 
                            	    32: VIRTUAL_DISPLAY_WIDTH = 320
                            	    33: BUSY = %10000000
                            	    34: HOG = %01000000
                            	    35: FXSR = %10000000
                            	    36: NFSR = %01000000
                            	    37: 
