                            	   313: 
                            	   314:         ifne    BAND
                            	   315: ; The lines of the old ball (a6) that the new one leaves get the full picture back, the lines that the new one
                            	   316: ; enters the version with registers 0-9, and the lines of both get the picture back under the old ball.
                            	   317: move_band:
                            	   318:         move.w  2(a6),d4             ; old first line, -1: none
                            	   319:         bmi     .enter_all
                            	   320:         move.w  ball_y,d5
                            	   321:         move.w  d5,d6
                            	   322:         sub.w   d4,d6                ; new - old
                            	   323:         beq     .same
                            	   324:         bpl.s   .down
                            	   325:         ; up: old lines new+32 .. old+32 leave, new .. old enter
                            	   326:         move.w  ball_y,d4
                            	   327:         addi.w  #32,d4
                            	   328:         move.w  2(a6),d5
                            	   329:         addi.w  #32,d5
                            	   330:         cmp.w   2(a6),d4
                            	   331:         bge.s   .up_leave
                            	   332:         move.w  2(a6),d4
                            	   333: .up_leave:
                            	   334:         lea     full_screen,a2
                            	   335:         lea     full_palettes,a3
                            	   336:         bsr     copy_lines
                            	   337:         move.w  ball_y,d4
                            	   338:         move.w  2(a6),d5
                            	   339:         move.w  ball_y,d0
                            	   340:         addi.w  #32,d0
                            	   341:         cmp.w   d0,d5
                            	   342:         ble.s   .up_enter
