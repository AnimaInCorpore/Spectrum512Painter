00:0000024E 31FC00028A20    	   239:         move.w  #2,$ffff8a20.w       ; source X increment
00:00000254 31C28A22        	   240:         move.w  d2,$ffff8a22.w       ; source Y increment
00:00000258 21C88A24        	   241:         move.l  a0,$ffff8a24.w
00:0000025C 76FF            	   242:         moveq   #-1,d3
00:0000025E 31C38A28        	   243:         move.w  d3,$ffff8a28.w       ; endmasks 1-3
00:00000262 21C38A2A        	   244:         move.l  d3,$ffff8a2a.w
00:00000266 31FC00028A2E    	   245:         move.w  #2,$ffff8a2e.w       ; destination X increment
00:0000026C 31C28A30        	   246:         move.w  d2,$ffff8a30.w       ; destination Y increment
00:00000270 21C98A32        	   247:         move.l  a1,$ffff8a32.w
00:00000274 31C08A36        	   248:         move.w  d0,$ffff8a36.w       ; X count
00:00000278 31C18A38        	   249:         move.w  d1,$ffff8a38.w       ; Y count
00:0000027C 31FC02038A3A    	   250:         move.w  #$0203,$ffff8a3a.w   ; HOP 2, OP 3
00:00000282 31FCC0008A3C    	   251:         move.w  #(BUSY+HOG)<<8,$ffff8a3c.w ; start, no FXSR/NFSR/skew
00:00000288 4E71            	   252:         nop
00:0000028A 4E75            	   253:         rts
